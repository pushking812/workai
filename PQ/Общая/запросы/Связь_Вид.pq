let
    // Читаемый вид Связь_ВОР_СО: под строкой пункта ВОР идут строки СО, на которые он ссылается.
    // Только четыре поля: Пункт, Наименование, КолВо, ЕдИзм. Строки СО отмечены "→ " в Пункте.
    // Порядок: файл ВОР, таблица, строка; внутри пункта - сначала ВОР, затем СО.
    Вор = Table.AddColumn(Table.AddColumn(Table.AddColumn(
        Table.Distinct(Table.SelectColumns(Связь_ВОР_СО, {"ИдСтроки", "ИмяФайла", "Таблица", "Строка", "NПП",
            "НаименованиеРабот", "КолВо", "ЕдИзм"}), {"ИдСтроки"}),
        "Тип", each 0, Int64.Type),
        "СоФайл", each "", type text),
        "СоСтрока", each 0, Int64.Type),
    ВорВид = Table.RenameColumns(Table.SelectColumns(Вор,
        {"ИмяФайла", "Таблица", "Строка", "Тип", "СоФайл", "СоСтрока", "NПП", "НаименованиеРабот", "КолВо", "ЕдИзм"}),
        {{"НаименованиеРабот", "Наименование"}, {"NПП", "Пункт"}}),
    Со = Table.AddColumn(Table.AddColumn(
        Table.SelectColumns(Связь_ВОР_СО, {"ИмяФайла", "Таблица", "Строка", "СО_ИмяФайла", "СО_Строка", "СО_NПП",
            "СО_НаименованиеИТехХар", "СО_КолВо", "СО_ЕдИзм"}),
        "Тип", each 1, Int64.Type),
        "Пункт", each "→ " & Text.From([СО_NПП]), type text),
    СоВид = Table.RenameColumns(Table.SelectColumns(Со,
        {"ИмяФайла", "Таблица", "Строка", "Тип", "СО_ИмяФайла", "СО_Строка", "Пункт", "СО_НаименованиеИТехХар", "СО_КолВо", "СО_ЕдИзм"}),
        {{"СО_ИмяФайла", "СоФайл"}, {"СО_Строка", "СоСтрока"}, {"СО_НаименованиеИТехХар", "Наименование"},
         {"СО_КолВо", "КолВо"}, {"СО_ЕдИзм", "ЕдИзм"}}),
    Все = Table.Combine({ВорВид, СоВид}),
    Отсортировано = Table.Sort(Все, {{"ИмяФайла", Order.Ascending}, {"Таблица", Order.Ascending}, {"Строка", Order.Ascending},
                                     {"Тип", Order.Ascending}, {"СоФайл", Order.Ascending}, {"СоСтрока", Order.Ascending}}),
    Итог = Table.SelectColumns(Отсортировано, {"Пункт", "Наименование", "КолВо", "ЕдИзм"})
in
    Итог
