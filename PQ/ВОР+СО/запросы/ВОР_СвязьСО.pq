let
    // Связь ВОР - СО в книге ВОР+СО: ключ в два прохода.
    // 1) строгий: ШифрПроекта|НомИзмПроекта|ДатаИзм|NПП (разбор NППРДСО - в ВОР_СвязьСОСтрогая, код шаблона ВОР);
    // 2) если такого ключа в СО нет - тот же пункт без даты (ШифрПроекта|НомИзмПроекта|NПП). Если вариантов
    //    с разной датой несколько, берётся ближайшая к дате ВОР.
    // Найденное без даты получает СвязьБезДаты = 1 и ДатаСО; такие строки попадают на лист «Ошибки»
    // как предупреждение «связь без даты». Остальные запросы читают КлючСО отсюда: он уже указывает на строки СО.
    Строгая = ВОР_СвязьСОСтрогая,
    СтрогиеКлючи = List.Buffer(List.Distinct(СО_Строки[КлючСО])),
    КлючБД = (ш as any, н as any, п as any) as text =>
        (if ш = null then "" else Text.From(ш)) & "|" & (if н = null then "" else Text.From(н)) & "|" & Text.From(п),
    ВариантыСО = Table.Group(
        Table.AddColumn(Table.Distinct(Table.SelectColumns(СО_Строки, {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП", "КлючСО"})),
            "КлючБД", each КлючБД([ШифрПроекта], [НомИзмПроекта], [NПП]), type text),
        {"КлючБД"}, {{"варианты", each Table.ToRecords(_), type list}}),
    С1 = Table.AddColumn(Строгая, "КлючБД", each КлючБД([ШифрПроекта], [НомИзмПроекта], [NПП]), type text),
    С2 = Table.ExpandTableColumn(Table.NestedJoin(С1, {"КлючБД"}, ВариантыСО, {"КлючБД"}, "в", JoinKind.LeftOuter), "в", {"варианты"}),
    Выбор = Table.AddColumn(С2, "Выбор", each
        let
            дв = [ДатаИзм],
            ключ = [КлючСО],
            в = [варианты],
            расст = (r as record) as number => if r[ДатаИзм] = null or дв = null then 0 else Number.Abs(Duration.Days(r[ДатаИзм] - дв)),
            лучший = if в = null then null else List.First(List.Sort(в, (a, b) => Value.Compare(расст(a), расст(b))))
        in
            if List.Contains(СтрогиеКлючи, ключ) or лучший = null
            then [к = ключ, д = дв, б = 0]
            else [к = лучший[КлючСО], д = лучший[ДатаИзм], б = 1]),
    Разобрано = Table.AddColumn(Table.AddColumn(Table.AddColumn(Выбор,
        "КлючСОНовый", each [Выбор][к], type text),
        "ДатаСО", each [Выбор][д], type date),
        "СвязьБезДаты", each [Выбор][б], Int64.Type),
    Итог = Table.RenameColumns(
        Table.RemoveColumns(Разобрано, {"КлючСО", "КлючБД", "варианты", "Выбор"}),
        {{"КлючСОНовый", "КлючСО"}})
in
    Итог
