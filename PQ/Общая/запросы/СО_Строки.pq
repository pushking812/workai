let
    // Строки СО для сверки с ВОР: нужные колонки СО_ФайлBinary (если колонки нет, она пустая).
    // Строки файлов с ошибкой чтения (без ИдСтроки) и строки без номера пункта в сверку не входят.
    Источник = СО_ФайлBinary,
    Нужные = {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "Раздел", "Комплект",
              "NПП", "НаименованиеИТехХар", "ЕдИзм", "КолВо", "Примечание", "КлючСО"},
    Колонки = if Table.HasColumns(Источник, "ИдСтроки")
        then Table.SelectColumns(Источник, Нужные, MissingField.UseNull)
        else #table(Нужные, {}),
    Итог = Table.SelectRows(Колонки, each [ИдСтроки] <> null and [NПП] <> null and [NПП] <> "")
in
    Итог
