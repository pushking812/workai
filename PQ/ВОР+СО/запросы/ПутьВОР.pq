let
    // Полный путь к книге ВОР: папка этой книги (формула ЯЧЕЙКА("filename")) + имя файла из таблицы «Параметры».
    // Папка пуста, пока книга не сохранена. Если файлы лежат раздельно, в ячейке «Папка» можно указать свой путь.
    Строка = Excel.CurrentWorkbook(){[Name = "Параметры"]}[Content]{0},
    Папка = if Строка[Папка] = null or Строка[Папка] = ""
        then error "Папка в таблице «Параметры» пуста: сохраните книгу (лист «Параметры»)"
        else Text.From(Строка[Папка]),
    Итог = Папка & (if Text.EndsWith(Папка, "\") then "" else "\") & Text.From(Строка[ФайлВОР])
in
    Итог
