let
    Source = СписокФайлов,
    
    // Прогоняем каждый файл через функцию, ловим ошибки
    ДобавленыДанные = Table.AddColumn(Source, "Данные", each 
        let
            // Table.Buffer заставляет PQ прочитать файл ПРЯМО СЕЙЧАС, внутри блока try
            результат = try Table.Buffer(fnProcessFile([ПолныйПуть]))
        in
            if результат[HasError] then 
                // Если произошла ошибка (битый ZIP или нет нужной колонки) - выводим ее в предупреждение
                #table(
                    {"ИмяФайла", "Предупреждение"}, 
                    {{ List.Last(Text.Split([ПолныйПуть], "\")), "ОШИБКА ОБРАБОТКИ: " & результат[Error][Message] }}
                )
            else 
                результат[Value]
    ),
    
    // Объединяем все таблицы в одну
    Объединено = Table.Combine(ДобавленыДанные[Данные])
in
    Объединено