let
    // Лист «Ошибки»: все замечания к связи ВОР и СО в одной таблице. Фильтруйте по ТипПроблемы.
    //  дубль номера в СО / ВОР - у нескольких строк документа одинаковый NПП (одна строка таблицы на номер);
    //  много ВОР на одну строку СО - на пункт СО ссылаются больше строк ВОР, чем в нём строк (СО суммируйте по СО_УчтеноОдинРаз);
    //  без пары / неоднозначно / нечётко / по остатку / дубль в СО - пара строки ВОР и строки СО внутри группы не однозначна;
    //  пункт СО не найден / нет ссылки на СО - строки из Только_в_ВОР;
    //  связь без даты - предупреждение: пункт СО найден только по шифру, номеру изменения и NПП (дата не совпала);
    //  связь по наименованию / связь по наименованию неоднозначна - предупреждение: строка из Только_в_ВОР и строка из Только_в_СО
    //  с разными номерами совпадают по словам наименования.
    Колонки = {"ТипПроблемы", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП", "СтрокВОР", "СтрокСО",
               "НаименованиеВОР", "НаименованиеСО", "ОценкаПары", "Пояснение", "КлючСО"},
    Текст = (x as any) as text => if x = null then "" else Text.From(x),
    Заготовка = (т as table) as table =>
        Table.SelectColumns(т & #table(Колонки, {}), Колонки),
    Типы = {{"ДатаИзм", type date}, {"СтрокВОР", Int64.Type}, {"СтрокСО", Int64.Type}, {"ОценкаПары", type number}},

    // 1) дубли номеров в СО
    СоГруппы = Table.Group(СО_Строки, {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП", "КлючСО"}, {
        {"СтрокСО", each Table.RowCount(_), Int64.Type},
        {"НаименованиеСО", each Текст([НаименованиеИТехХар]{0}), type text}}),
    ДублиСО = Table.SelectRows(СоГруппы, each [СтрокСО] > 1),
    ДублиСОТ = Table.AddColumn(Table.AddColumn(ДублиСО, "ТипПроблемы", each "дубль номера в СО", type text), "Пояснение",
        each "В СО " & Text.From([СтрокСО]) & " строк с номером " & [NПП] & ". Связь с ВОР идёт по номеру на уровне группы, суммы СО не затронуты.", type text),

    // 2) дубли номеров в ВОР
    ВорГруппы = Table.Group(ВОР_Строки, {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП"}, {
        {"СтрокВОР", each Table.RowCount(_), Int64.Type},
        {"НаименованиеВОР", each Текст([НаименованиеРабот]{0}), type text}}),
    ДублиВОР = Table.SelectRows(ВорГруппы, each [СтрокВОР] > 1 and [NПП] <> null),
    ДублиВОРТ = Table.AddColumn(Table.AddColumn(ДублиВОР, "ТипПроблемы", each "дубль номера в ВОР", type text), "Пояснение",
        each "В ВОР " & Text.From([СтрокВОР]) & " строк с номером " & [NПП] & ". Связь с СО идёт по ссылке NППРДСО, не по этому номеру.", type text),

    // 3) группы, где число строк ВОР и СО не сходится, и неоднозначные пары (одна запись на строку ВОР и пункт СО)
    Связь = Table.Distinct(Table.SelectColumns(Связь_ВОР_СО, {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NППСО",
        "НаименованиеРабот", "КлючСО", "ВОР_СтрокГруппы", "СО_СтрокГруппы", "СтатусПары", "ОценкаПары"})),
    Спорные = Table.SelectRows(Связь, each List.Contains({"нечётко", "по остатку", "дубль в СО", "доля по КолВо", "проверить вручную", "единицы разные", "нет аналога (другая единица)", "числа не совпали", "ВОР без доли"}, [СтатусПары])),
    СпорныеТ = Table.AddColumn(Table.RenameColumns(Спорные, {{"NППСО", "NПП"}, {"НаименованиеРабот", "НаименованиеВОР"},
            {"ВОР_СтрокГруппы", "СтрокВОР"}, {"СО_СтрокГруппы", "СтрокСО"}, {"СтатусПары", "ТипПроблемы"}}),
        "Пояснение", each
            if [ТипПроблемы] = "дубль в СО" then "В СО все строки пункта одинаковы, различить нечем. Суммы не затронуты."
            else if [ТипПроблемы] = "ВОР без доли" then "Объём СО этого пункта отдан другой строке ВОР (более подходящее наименование или числа не совпали); у этой строки доля СО 0, проверьте ссылку."
            else if [ТипПроблемы] = "доля по КолВо" then "Объём строки СО поделён между строками ВОР пропорционально их КолВо (единицы равны)."
            else if [ТипПроблемы] = "проверить вручную" then "На строку СО подходят несколько строк ВОР в той же единице, но их объёмы не сходятся с СО (ни деление, ни операции): объём отдан первой, проверьте."
            else if [ТипПроблемы] = "единицы разные" then "Единицы ВОР и СО разные, объёмы сравнить нельзя: объём СО учтён у первой строки ВОР."
            else if [ТипПроблемы] = "нет аналога (другая единица)" then "У строки ВОР другая единица, чем у строки СО (например, штуки и метры): аналога в СО нет, объём СО ей не достаётся, в сводной пусто."
            else if [ТипПроблемы] = "числа не совпали" then "Числа из наименования СО не найдены ни в одной строке ВОР, пара подобрана без проверки чисел."
            else if [ТипПроблемы] = "нечётко" then "Пара найдена по части слов, проверьте."
            else "Пара поставлена на оставшуюся строку СО без отличительных слов, проверьте.", type text),
    Много = Table.Group(Связь, {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NППСО", "КлючСО"}, {
        {"СтрокВОР", each List.Max([ВОР_СтрокГруппы]), Int64.Type},
        {"СтрокСО", each List.Max([СО_СтрокГруппы]), Int64.Type},
        {"НаименованиеВОР", each Текст([НаименованиеРабот]{0}), type text}}),
    МногоВыбор = Table.SelectRows(Много, each [СтрокВОР] > [СтрокСО]),
    МногоТ = Table.AddColumn(Table.AddColumn(Table.RenameColumns(МногоВыбор, {{"NППСО", "NПП"}}),
        "ТипПроблемы", each "много ВОР на одну строку СО", type text), "Пояснение",
        each "На пункт СО " & [NПП] & " ссылаются " & Text.From([СтрокВОР]) & " строк ВОР при " & Text.From([СтрокСО])
             & " строк в СО. Суммируйте СО по СО_УчтеноОдинРаз.", type text),

    // 4) строки ВОР без пункта СО
    БезСО = Table.RenameColumns(Table.SelectColumns(Только_в_ВОР,
        {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NППСО", "НаименованиеРабот", "Причина", "КлючСО"}),
        {{"NППСО", "NПП"}, {"НаименованиеРабот", "НаименованиеВОР"}, {"Причина", "ТипПроблемы"}}),
    БезСОТ = Table.AddColumn(БезСО, "Пояснение", each
        if [ТипПроблемы] = "нет ссылки на СО" then "NППРДСО пуст или ссылка не распознана." else "Пункта нет в СО (другая версия СО или опечатка).", type text),

    // 5) предупреждение: пункт СО найден только без даты изменения (строгий ключ с датой не совпал)
    БезДатыСтроки = Table.ExpandTableColumn(
        Table.NestedJoin(Table.SelectRows(ВОР_СвязьСО, each [СвязьБезДаты] = 1), {"ИдСтроки"}, ВОР_Строки, {"ИдСтроки"}, "вор", JoinKind.Inner),
        "вор", {"НаименованиеРабот"}, {"НаименованиеВОР"}),
    БезДатыГр = Table.Group(БезДатыСтроки, {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП", "КлючСО", "ДатаСО"}, {
        {"СтрокВОР", each List.Count(List.Distinct([ИдСтроки])), Int64.Type},
        {"НаименованиеВОР", each Текст([НаименованиеВОР]{0}), type text}}),
    ДатаТекст = (д as any) as text => if д = null then "не указана" else Date.ToText(д, "dd.MM.yyyy"),
    // Если для одной пары дат (ВОР, СО) таких пунктов больше 5, даты разошлись по всему комплекту: одна запись на пару дат.
    ПарыДат = {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ДатаСО"},
    БезДатыСчёт = Table.Group(БезДатыГр, ПарыДат, {{"Чис", each Table.RowCount(_), Int64.Type}}),
    БезДатыСЧ = Table.ExpandTableColumn(Table.NestedJoin(БезДатыГр, ПарыДат, БезДатыСчёт, ПарыДат, "с", JoinKind.Inner), "с", {"Чис"}),
    БезДатыОтд = Table.AddColumn(Table.AddColumn(Table.SelectRows(БезДатыСЧ, each [Чис] <= 5), "ТипПроблемы", each "связь без даты", type text), "Пояснение",
        each "Предупреждение: пункт " & Текст([NПП]) & " найден в СО только без учёта даты изменения (дата в ВОР " & ДатаТекст([ДатаИзм])
             & ", в СО " & ДатаТекст([ДатаСО]) & "). Проверьте, что это одна версия документов.", type text),
    БезДатыСвёрн = Table.Group(Table.SelectRows(БезДатыСЧ, each [Чис] > 5), ПарыДат, {
        {"СтрокСО", each Table.RowCount(_), Int64.Type},
        {"СтрокВОР", each List.Sum([СтрокВОР]), Int64.Type},
        {"NПП", each Текст(List.Sort([NПП]){0}), type text},
        {"Номера", each Text.Combine(List.Transform(List.FirstN(List.Sort(List.Transform([NПП], Текст)), 5), each _), ", "), type text},
        {"НаименованиеВОР", each Текст([НаименованиеВОР]{0}), type text}}),
    БезДатыСвТ = Table.AddColumn(Table.AddColumn(БезДатыСвёрн, "ТипПроблемы", each "связь без даты", type text), "Пояснение",
        each "Предупреждение: для " & Text.From([СтрокСО]) & " пунктов СО связь найдена только без учёта даты изменения (дата в ВОР "
             & ДатаТекст([ДатаИзм]) & ", в СО " & ДатаТекст([ДатаСО]) & "). Первые номера: " & [Номера]
             & ". Скорее всего, версии документов разошлись по всему комплекту: проверьте штампы.", type text),
    БезДатыТ = Table.Combine({БезДатыОтд, БезДатыСвТ}),

    // 6) предупреждение: строка ВОР и пункт СО не связаны по номеру, но совпадают по словам наименования (запрос СвязьПоИмени).
    //    «связь по наименованию» - пара однозначная: она уже учтена в Пересечении и Связь_ВОР_СО (столбец Связь), здесь только предупреждение;
    //    «связь по наименованию неоднозначна» - пара не поставлена, одна запись на строку ВОР (число подходящих пунктов СО и первые 5 номеров).
    ТочныеТ = Table.AddColumn(Table.AddColumn(Table.AddColumn(
        Table.SelectRows(СвязьПоИмени, each [Статус] = "по наименованию"),
        "ТипПроблемы", each "связь по наименованию", type text),
        "СтрокВОР", each 1, Int64.Type),
        "Пояснение", each "Предупреждение: пункт ВОР " & Текст([NПП]) & " и пункт СО " & Текст([NППСО])
            & " не связаны по номеру, но совпадают по наименованию; пара учтена в Пересечении. Проверьте, что это один и тот же пункт.", type text),
    НеоднТ = Table.AddColumn(Table.AddColumn(Table.AddColumn(
        Table.SelectRows(СвязьПоИмени, each [Статус] = "неоднозначно"),
        "ТипПроблемы", each "связь по наименованию неоднозначна", type text),
        "СтрокВОР", each 1, Int64.Type),
        "Пояснение", each "Предупреждение: пункт ВОР " & Текст([NПП]) & " не связан по номеру, но по наименованию подходят пункты СО, всего "
            & Text.From([СтрокСО]) & ": " & [Номера] & (if [СтрокСО] > 5 then " и др." else "") & ". "
            & (if [СтрокСО] > 5 then "Если это сводная строка «в том числе», связь ожидаема; иначе проверьте." else "Проверьте, какой из них нужен."), type text),
    НаимТаблица = Table.Combine({Заготовка(ТочныеТ), Заготовка(НеоднТ)}),

    // 7) предупреждение «ссылка, вероятно, сдвинута»: строка ВОР, чья ссылка не подтверждается наименованием
    //    (ни у одной связанной строки СО все слова не входят в наименование ВОР: это «ВОР без доли» и подобные), и строка СО,
    //    которую не подтверждает ни одна связанная строка ВОР (в том числе пункты без ВОР), совпадают по словам наименования.
    //    Пара берётся только если она единственная лучшая и для ВОР, и для СО (оценка = число слов СО). Это только предупреждение:
    //    связи и суммы не меняются, ссылку в ВОР исправляют вручную. Правила слов те же, что в СвязьПоИмени (блок 6).
    Слова7 = (t as text) as list =>
        let
            s = List.Accumulate({"/", ",", "(", ")", ";", ":", "-", "–", "—", "«", "»", """", "'", "#(00A0)", "#(lf)", "#(cr)", "#(tab)", "=", "+", "*", "[", "]", "|"},
                Text.Replace(Text.Lower(t), "ё", "е"), (a, d) => Text.Replace(a, d, " ")),
            w = List.Select(List.Transform(Text.Split(s, " "), each Text.Trim(_, ".")), each Text.Length(_) >= 3 or Text.Select(_, {"0".."9"}) <> ""),
            основа = List.Transform(w, each if Text.Select(_, {"0".."9"}) <> "" then _ else Text.Range(_, 0, List.Min({Text.Length(_), 5})))
        in List.Distinct(основа),
    Подходит7 = (со as list, вор as list) as logical => List.Count(со) >= 2 and List.IsEmpty(List.Difference(со, вор)),
    Св7 = Table.Buffer(Table.Distinct(Table.SelectColumns(Связь_ВОР_СО, {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП",
        "НаименованиеРабот", "NППСО", "КлючСО", "СО_ИмяФайла", "СО_Таблица", "СО_Строка", "СО_НаименованиеИТехХар"}))),
    Св7П = Table.AddColumn(Table.AddColumn(Св7, "СоИд", each Текст([КлючСО]) & "#" & Текст([СО_ИмяФайла]) & "#" & Текст([СО_Таблица]) & "#" & Текст([СО_Строка]), type text),
        "Подтв", each Подходит7(Слова7(Текст([СО_НаименованиеИТехХар])), Слова7(Текст([НаименованиеРабот]))), type logical),
    ВорПодтв = Table.Group(Св7П, {"ИдСтроки"}, {{"п", each List.AnyTrue([Подтв]), type logical},
        {"Ссылки", each Text.Combine(List.Distinct(List.Transform([NППСО], Текст)), ", "), type text}}),
    СоПодтв = Table.Distinct(Table.SelectColumns(Table.SelectRows(Св7П, each [Подтв]), {"СоИд"})),
    ВорДан7 = Table.Distinct(Table.SelectColumns(Св7П, {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП", "НаименованиеРабот"})),
    ВорН7 = Table.Buffer(Table.SelectRows(Table.ExpandTableColumn(
        Table.NestedJoin(ВорДан7, {"ИдСтроки"}, ВорПодтв, {"ИдСтроки"}, "т", JoinKind.Inner), "т", {"п", "Ссылки"}), each [п] = false)),
    СоВсе7 = Table.AddColumn(Table.SelectColumns(СО_Строки, {"ШифрПроекта", "НомИзмПроекта", "КлючСО", "ИмяФайла", "Таблица", "Строка", "NПП", "НаименованиеИТехХар"}),
        "СоИд", each Текст([КлючСО]) & "#" & Текст([ИмяФайла]) & "#" & Текст([Таблица]) & "#" & Текст([Строка]), type text),
    СоН7 = Table.Buffer(Table.RemoveColumns(Table.NestedJoin(СоВсе7, {"СоИд"}, СоПодтв, {"СоИд"}, "п", JoinKind.LeftAnti), {"п"})),
    // List.Buffer обязателен (см. блок 6)
    ВЗ7 = List.Buffer(Table.ToRecords(ВорН7)),
    СЗ7 = List.Buffer(Table.ToRecords(СоН7)),
    ВС7 = List.Buffer(List.Transform(ВЗ7, each List.Buffer(Слова7(Текст([НаименованиеРабот]))))),
    СС7 = List.Buffer(List.Transform(СЗ7, each List.Buffer(Слова7(Текст([НаименованиеИТехХар]))))),
    Кан7 = List.Combine(List.Transform(List.Positions(ВЗ7), (i) =>
        List.Transform(List.Select(List.Positions(СЗ7), (j) =>
            ВЗ7{i}[ШифрПроекта] = СЗ7{j}[ШифрПроекта] and ВЗ7{i}[НомИзмПроекта] = СЗ7{j}[НомИзмПроекта] and Подходит7(СС7{j}, ВС7{i})),
            (j) => [и = i, ж = j, к = List.Count(СС7{j})]))),
    КанТаб7 = if List.IsEmpty(Кан7) then #table(type table [и = Int64.Type, ж = Int64.Type, к = Int64.Type], {})
              else Table.TransformColumnTypes(Table.FromRecords(Кан7), {{"и", Int64.Type}, {"ж", Int64.Type}, {"к", Int64.Type}}),
    Лучший7 = (т as table) as list => let м = List.Max(т[к]) in {м, List.Count(List.Select(т[к], each _ = м))},
    МВ7 = Table.AddColumn(Table.AddColumn(Table.Group(КанТаб7, {"и"}, {{"р", Лучший7, type list}}), "мв", each [р]{0}), "нв", each [р]{1}),
    МС7 = Table.AddColumn(Table.AddColumn(Table.Group(КанТаб7, {"ж"}, {{"р", Лучший7, type list}}), "мс", each [р]{0}), "нс", each [р]{1}),
    СМВ7 = Table.ExpandTableColumn(Table.NestedJoin(КанТаб7, {"и"}, Table.SelectColumns(МВ7, {"и", "мв", "нв"}), {"и"}, "т", JoinKind.Inner), "т", {"мв", "нв"}),
    СМС7 = Table.ExpandTableColumn(Table.NestedJoin(СМВ7, {"ж"}, Table.SelectColumns(МС7, {"ж", "мс", "нс"}), {"ж"}, "т", JoinKind.Inner), "т", {"мс", "нс"}),
    Пары7 = Table.SelectRows(СМС7, each [к] = [мв] and [к] = [мс] and [нв] = 1 and [нс] = 1),
    СдвигЗаписи = List.Transform(Table.ToRecords(Пары7), (p) =>
        let в = ВЗ7{p[и]}, с = СЗ7{p[ж]}
        in [ТипПроблемы = "ссылка, вероятно, сдвинута", ШифрПроекта = в[ШифрПроекта], НомИзмПроекта = в[НомИзмПроекта], ДатаИзм = в[ДатаИзм],
            NПП = Текст(в[NПП]), СтрокВОР = 1, СтрокСО = 1,
            НаименованиеВОР = Текст(в[НаименованиеРабот]), НаименованиеСО = Текст(с[НаименованиеИТехХар]), КлючСО = с[КлючСО],
            Пояснение = "Предупреждение: ссылка ВОР, вероятно, сдвинута. Пункт ВОР " & Текст(в[NПП]) & " ссылается на пункт СО " & в[Ссылки]
                & ", но наименование не совпадает; по наименованию подходит пункт СО " & Текст(с[NПП])
                & ". Связи и суммы не менялись, проверьте и исправьте ссылку в ВОР."]),
    СдвигТ = if List.IsEmpty(СдвигЗаписи) then #table(Колонки, {}) else Table.FromRecords(СдвигЗаписи),

    Все = Table.Combine({Заготовка(ДублиСОТ), Заготовка(ДублиВОРТ), Заготовка(СпорныеТ), Заготовка(МногоТ), Заготовка(БезСОТ), Заготовка(БезДатыТ), НаимТаблица, Заготовка(СдвигТ)}),
    Итог = Table.Sort(Table.TransformColumnTypes(Все, Типы), {{"ТипПроблемы", Order.Ascending}, {"NПП", Order.Ascending}})
in
    Итог
