let
    // Итоговая таблица ФайлBinary из книги ВОР (путь - ПутьВОР). Обработка данных в шаблоне ВОР, здесь только чтение.
    // Типы: Excel отдаёт столбцы без типа, поэтому КолВо = число, ДатаИзм = дата (нужно модели данных и сводной).
    // Не входят: пустая строка пустой таблицы шаблона (ИдСтроки пуст), строка итогов таблицы ВОР (подпись "Итог",
    // Excel.Workbook отдаёт её как строку данных) и строки файлов с ошибкой чтения (без ИдСтроки).
    Книга = Excel.Workbook(File.Contents(ПутьВОР), null, true),
    Таблица = Книга{[Item = "ФайлBinary", Kind = "Table"]}[Data],
    Строки = Table.SelectRows(Таблица, each [ИдСтроки] <> null and [ИдСтроки] <> "Итог"),
    Итог = Table.TransformColumnTypes(Строки, {{"КолВо", type number}, {"ДатаИзм", type date}})
in
    Итог
