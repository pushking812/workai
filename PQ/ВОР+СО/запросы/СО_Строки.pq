let
    // Итоговая таблица ФайлBinary из книги СО (путь - ПутьСО). Обработка данных в шаблоне СО, здесь только чтение.
    // Типы: Excel отдаёт столбцы без типа, поэтому КолВо = число, ДатаИзм = дата (нужно модели данных и сводной).
    // Пустая строка пустой таблицы шаблона, строки файлов с ошибкой чтения (без ИдСтроки) и строки без номера пункта в сверку не входят.
    Книга = Excel.Workbook(File.Contents(ПутьСО), null, true),
    Таблица = Книга{[Item = "ФайлBinary", Kind = "Table"]}[Data],
    Строки = Table.SelectRows(Таблица, each [ИдСтроки] <> null and [NПП] <> null and [NПП] <> ""),
    Итог = Table.TransformColumnTypes(Строки, {{"КолВо", type number}, {"ДатаИзм", type date}})
in
    Итог
