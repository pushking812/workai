let
    База = СО_База,

    // Строки файлов с ошибкой чтения (колонка "Предупреждение") отделяем и возвращаем в конец
    ЕстьОшибки = Table.HasColumns(База, "Предупреждение"),
    ОшибочныеТаблицы = if ЕстьОшибки
        then {Table.SelectColumns(Table.SelectRows(База, each [Предупреждение] <> null), {"ИмяФайла", "Предупреждение"})}
        else {},
    Хорошие = if ЕстьОшибки
        then Table.RemoveColumns(Table.SelectRows(База, each [Предупреждение] = null), {"Предупреждение"})
        else База,

    // Служебные колонки и роли шаблона идут в фиксированном порядке, роли пользователя - после них, ключ - последним
    Начало = {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "Раздел", "РазделНПП", "Комплект",
              "NПП", "НаименованиеИТехХар", "ТипМаркаОбозначение", "КодПродукции", "Поставщик",
              "ЕдИзм", "КолВо", "Масса1ЕдКг", "Примечание"},

    // Комплекты и разделы (обработка каждой таблицы файла отдельно, строки идут в порядке файла).
    //
    // Комплект: родитель - наименование оканчивается на "в составе" / "в составе:". В колонку "Комплект"
    //   пишется NПП ближайшего объемлющего комплекта (3.1.1 -> 3.1; вложенный 14.3 -> 14);
    //   у самой строки комплекта верхнего уровня - её собственный NПП (3.1 -> 3.1).
    //   Составляющие: NПП вида N.k...; либо пустой NПП (строка с данными, либо наименование начинается
    //   со счётчика 1, 2, 3...). Пустая строка завершает комплект, если дальше нет номера N.k.
    //   NПП у безномерных составляющих не переписывается.
    // Раздел: строка, где заполнено только наименование (NПП пуст или число), не комплект, и
    //   - без номера: ниже в таблице есть строка с данными;
    //   - с номером N: ниже есть строка с номером N.1 (N.1.k).
    //   Номер раздела в текст не входит. Уровни: без номера - глубина 0, с номером - число частей номера;
    //   в колонке "Раздел" уровни через " | ". Соседние безномерные заголовки склеиваются через пробел,
    //   если следующий начинается со строчной буквы, а предыдущий оканчивается на "," или предлог.
    // Пустые строки и строки-разделы удаляются. Кандидат в раздел с номером N, у которого есть N.k
    //   без N.1, остаётся строкой данных, в колонке "Проверка" - пометка (решает пользователь).
    СлужебныеКолонкиРаздела = {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "NПП", "НаименованиеИТехХар"},
    Предлоги = {"в", "во", "на", "и", "для", "с", "со", "по", "к", "от", "из", "при", "до", "над", "под", "о", "об", "за", "у", "или"},
    текст = (х) => if х = null then "" else Text.Trim(Text.From(х)),
    // хвостовое число номера: "1." -> "1", "УПСД ЭЭ (ЕДЦМ) 1." -> "1", "2.1" -> "2.1"
    хвост = (с as text) as text =>
        let
            т0 = Text.TrimEnd(с, "."),
            симв = Text.ToList(т0),
            не_цифры = List.Select(List.Positions(симв), each not List.Contains({"0".."9"} & {"."}, симв{_})),
            старт = if List.IsEmpty(не_цифры) then 0 else List.Last(не_цифры) + 1
        in
            Text.TrimStart(Text.Range(т0, старт), "."),
    этоРодитель = (н as text) as logical =>
        Text.EndsWith(Text.Lower(Text.TrimEnd(н, {":", " ", "."})), "в составе"),
    доРазд = (т as text, р as text) as text =>
        let п = Text.PositionOf(т, р) in if п < 0 then т else Text.Range(т, 0, п),
    этоСчётчик = (н as text) as logical =>
        let ч = Text.TrimEnd(доРазд(н & " ", " "), ".")
        in ч <> "" and Text.Remove(ч, {"0".."9"}) = "",
    ОбработатьТаблицу = (т as table) as table =>
        let
            строки = Table.ToRecords(т),
            колонки = List.Difference(Table.ColumnNames(т), СлужебныеКолонкиРаздела),
            колонкиБезОбъёма = List.Difference(колонки, {"ЕдИзм", "КолВо"}),
            инфо0 = List.Transform(строки, each
                let
                    с = _,
                    наим = текст(с[НаименованиеИТехХар]),
                    нпп = текст(с[NПП]),
                    н = хвост(нпп),
                    данные = List.AnyTrue(List.Transform(колонки, each текст(Record.Field(с, _)) <> "")),
                    лнаим = Text.Lower(наим)
                in
                    [наим = наим, н = н, данные = данные,
                     пусто = наим = "" and нпп = "" and not данные,
                     толькоНаим = наим <> "" and not данные and (нпп = "" or н <> ""),
                     родитель = этоРодитель(наим), счётчик = этоСчётчик(наим),
                     // слово-признак комплекта: "Комплекс..." / "Комплект..." с номером и без данных
                     словоКомплекта = н <> "" and наим <> "" and not данные
                         and (Text.StartsWith(лнаим, "комплекс") or Text.StartsWith(лнаим, "комплект")),
                     // строка без номера: наименование, ЕдИзм и КолВо, остальное пусто (возможный раздел с объёмом)
                     // строка с данными, ЕдИзм "компл...", есть номер: комплект, если ниже стоит N.1
                     единицаКомплект = н <> "" and данные and Text.StartsWith(Text.Lower(Text.Trim(текст(с[ЕдИзм]))), "компл"),
                     разделСОбъёмом = нпп = "" and наим <> "" and текст(с[ЕдИзм]) <> "" and текст(с[КолВо]) <> ""
                         and not List.AnyTrue(List.Transform(колонкиБезОбъёма, each текст(Record.Field(с, _)) <> ""))]),
            инфо = List.Transform(List.Positions(инфо0), each
                let
                    r = инфо0{_},
                    после = List.Skip(инфо0, _ + 1),
                    безСостава = (r[словоКомплекта] or r[единицаКомплект]) and not r[родитель]
                        and List.AnyTrue(List.Transform(после, each [н] = r[н] & ".1" or Text.StartsWith([н], r[н] & ".1.")))
                in
                    Record.AddField(Record.TransformFields(r, {{"родитель", each _ or безСостава}}), "безСостава", безСостава)),
            позиции = List.Positions(инфо),

            // 1) комплекты
            // стек - номера открытых комплектов от внешнего к внутреннему; "Комплект" строки - ближайший
            // объемлющий комплект (3.1.1 -> 3.1; вложенный комплект 14.3 -> 14); у комплекта верхнего
            // уровня - его собственный номер (3.1 -> 3.1).
            пройдено1 = List.Accumulate(позиции, [ст = {}, вых = {}], (с, i) =>
                let
                    r = инфо{i},
                    след = List.FirstN(List.Select(List.Skip(инфо, i + 1), each not [пусто]), 1),
                    стН = if r[н] = "" then с[ст] else List.Select(с[ст], each Text.StartsWith(r[н], _ & ".")),
                    верх = if List.IsEmpty(стН) then null else List.Last(стН),
                    решение =
                        if r[пусто] then
                            [ст = if List.IsEmpty(след) then {} else List.Select(с[ст], each Text.StartsWith(след{0}[н], _ & ".")), ком = null]
                        else if r[родитель] then
                            (if r[н] <> "" then [ст = стН & {r[н]}, ком = if верх = null then r[н] else верх]
                             else [ст = {}, ком = null])
                        else if r[н] <> "" then
                            [ст = стН, ком = верх]
                        else if not List.IsEmpty(с[ст]) and (r[данные] or r[счётчик]) then [ст = с[ст], ком = List.Last(с[ст])]
                        else [ст = {}, ком = null]
                in
                    [ст = решение[ст], вых = с[вых] & {решение[ком]}]),
            комплект = пройдено1[вых],

            // 2) разделы
            допустим = (i as number) =>
                let
                    r = инфо{i},
                    после = List.Skip(инфо, i + 1)
                in
                    if r[н] = "" then List.AnyTrue(List.Transform(после, each [данные]))
                    else List.AnyTrue(List.Transform(после, each [н] = r[н] & ".1" or Text.StartsWith([н], r[н] & ".1."))),
            смягчённо = (i as number) =>
                let r = инфо{i}
                in r[н] <> "" and List.AnyTrue(List.Transform(List.Skip(инфо, i + 1), each Text.StartsWith([н], r[н] & "."))),
            склеить = (было as text, новое as text) as logical =>
                let
                    первая = Text.Range(новое & " ", 0, 1),
                    слова = Text.Split(Text.Lower(было), " ")
                in
                    первая <> Text.Upper(первая) or Text.EndsWith(было, ",") or List.Contains(Предлоги, List.Last(слова)),
            пройдено2 = List.Accumulate(позиции, [стек = {}, последний = -5, вых = {}], (с, i) =>
                let
                    r = инфо{i},
                    путь = if List.IsEmpty(с[стек]) then null else Text.Combine(List.Transform(с[стек], each [имя]), " | "),
                    номера = List.Select(List.Transform(с[стек], each [н]), each _ <> ""),
                    путьНпп = if List.IsEmpty(номера) then null else Text.Combine(номера, " | "),
                    данныеСтроки = [стек = с[стек], последний = с[последний],
                                    вых = с[вых] & {[раздел = путь, разделНпп = путьНпп, удалить = false,
                                        проверка =
                                            if r[безСостава] and r[единицаКомплект] then "комплект без «в составе:» (определён по ЕдИзм «компл» и подчинённым " & r[н] & ".1)"
                                            else if r[безСостава] then "комплект без «в составе:» (определён по слову «Комплекс/Комплект» и подчинённым " & r[н] & ".1)"
                                            else if r[разделСОбъёмом] then "возможный раздел: заголовок без номера, но с объёмом (ЕдИзм и КолВо); проверьте файл"
                                            else null]}],
                    кандидат = комплект{i} = null and r[толькоНаим] and not r[родитель]
                in
                    if r[пусто] then
                        [стек = с[стек], последний = с[последний], вых = с[вых] & {[раздел = null, разделНпп = null, удалить = true, проверка = null]}]
                    else if not кандидат then данныеСтроки
                    else if not допустим(i) then
                        [стек = с[стек], последний = с[последний],
                         вых = с[вых] & {[раздел = путь, разделНпп = путьНпп, удалить = false,
                                          проверка = if смягчённо(i) then "возможный раздел: есть подчинённые " & r[н] & ".k без " & r[н] & ".1" else null]}]
                    else if not List.IsEmpty(с[стек]) and с[последний] = i - 1 and r[н] = "" and склеить(List.Last(с[стек])[имя], r[наим]) then
                        [стек = List.RemoveLastN(с[стек], 1) & {[гл = List.Last(с[стек])[гл], н = List.Last(с[стек])[н], имя = List.Last(с[стек])[имя] & " " & r[наим]]},
                         последний = i, вых = с[вых] & {[раздел = null, разделНпп = null, удалить = true, проверка = null]}]
                    else
                        let гл = if r[н] = "" then 0 else List.Count(Text.Split(r[н], "."))
                        in [стек = List.Select(с[стек], each [гл] < гл) & {[гл = гл, н = r[н], имя = r[наим]]},
                            последний = i, вых = с[вых] & {[раздел = null, разделНпп = null, удалить = true, проверка = null]}]),
            решения = пройдено2[вых],

            с1 = Table.AddIndexColumn(т, "_и", 0, 1),
            с2 = Table.AddColumn(с1, "Комплект", each комплект{[_и]}, type text),
            с3 = Table.AddColumn(с2, "Раздел", each решения{[_и]}[раздел], type text),
            с3б = Table.AddColumn(с3, "РазделНПП", each решения{[_и]}[разделНпп], type text),
            с3в = Table.AddColumn(с3б, "Строка", each [_и] + 1, Int64.Type),
            с4 = Table.AddColumn(с3в, "Проверка", each решения{[_и]}[проверка], type text),
            с5 = Table.AddColumn(с4, "_удалить", each решения{[_и]}[удалить], type logical)
        in
            Table.RemoveColumns(Table.SelectRows(с5, each not [_удалить]), {"_и", "_удалить"}),
    СРазделом = if not Table.HasColumns(Хорошие, {"ИмяФайла", "Таблица", "NПП", "НаименованиеИТехХар"}) or Table.IsEmpty(Хорошие) then Хорошие else
        Table.Combine(Table.Group(Хорошие, {"ИмяФайла", "Таблица"},
            {{"Данные", each ОбработатьТаблицу(_), type table}}, GroupKind.Local)[Данные]),

    // Повторы номера пункта: в одном файле NПП может встречаться несколько раз с разными объёмами
    // и примечаниями. Если все остальные поля (кроме ИдСтроки, КолВо, Примечание, Масса1ЕдКг) совпадают:
    //   1) масса 1 ед. и объём каждой строки дописываются в её примечание ("примечание: масса: объём ед"),
    //      значение Масса1ЕдКг у свёрнутой строки удаляется,
    //   2) строки сворачиваются в одну: объёмы суммируются, примечания объединяются через "; ".
    // Не сворачиваются: строки без NПП и группы, где объём не число (тогда строки остаются как есть).
    СлужебныеПоля = {"ИдСтроки", "КолВо", "Примечание", "Масса1ЕдКг"},
    Свернуть = (т as table) as table =>
        let
            строки = Table.ToRecords(т),
            пусто = (х) => х = null or Text.Trim(Text.From(х)) = "",
            нпп = строки{0}[NПП],
            объёмыТекст = List.Transform(строки, each if пусто(_[КолВо]) then null else Text.Trim(Text.From(_[КолВо]))),
            числа = List.Transform(объёмыТекст, each
                if _ = null then null
                else try Number.FromText(Text.Replace(Text.Replace(_, " ", ""), ",", "."), "en-US") otherwise null),
            можно = Table.RowCount(т) > 1 and not пусто(нпп) and not List.Contains(числа, null),
            запятая = List.AnyTrue(List.Transform(объёмыТекст, each Text.Contains(_, ","))),
            сумма = List.Sum(числа),
            суммаТекст = (if запятая then Text.Replace(Number.ToText(сумма, "0.###############", "en-US"), ".", ",")
                          else Number.ToText(сумма, "0.###############", "en-US")),
            // ед. изм. одинакова во всей группе (входит в ключи группировки)
            ед = if not Table.HasColumns(т, "ЕдИзм") or пусто(строки{0}[ЕдИзм]) then "" else " " & Text.Trim(Text.From(строки{0}[ЕдИзм])),
            заметки = List.Transform(List.Positions(строки), each
                let
                    п = if пусто(строки{_}[Примечание]) then null else Text.Trim(Text.From(строки{_}[Примечание])),
                    // масса 1 ед. переносится в примечание, из колонки Масса1ЕдКг удаляется
                    м = if not Table.HasColumns(т, "Масса1ЕдКг") or пусто(строки{_}[Масса1ЕдКг]) then null
                        else Text.Trim(Text.From(строки{_}[Масса1ЕдКг])),
                    части = List.RemoveNulls({п, м, объёмыТекст{_} & ед})
                in
                    Text.Combine(части, ": ")),
            первая = Table.FirstN(т, 1),
            минСтрока = List.Min(List.Transform(строки, each _[Строка])),
            свёрнутая = Table.TransformColumns(первая, {{"КолВо", each суммаТекст, type text},
                                                        {"Примечание", each Text.Combine(заметки, "; "), type text},
                                                        {"Строка", each минСтрока, Int64.Type}})
        in
            if not можно then т
            else if Table.HasColumns(свёрнутая, "Масса1ЕдКг")
                then Table.TransformColumns(свёрнутая, {{"Масса1ЕдКг", each null}})
                else свёрнутая,
    Свёрнутые = if not Table.HasColumns(СРазделом, {"ИдСтроки", "NПП", "КолВо", "Примечание"}) or Table.IsEmpty(СРазделом) then СРазделом else
        let
            ключи = List.Difference(Table.ColumnNames(СРазделом), СлужебныеПоля & {"Строка", "РазделНПП"}),
            группы = Table.Group(СРазделом, ключи, {{"т", each _, type table}})
        in
            Table.Combine(List.Transform(Table.Column(группы, "т"), each Свернуть(_))),

    // Ключ связи с ВОР: ШифрПроекта | НомИзмПроекта | ДатаИзм (гггг-мм-дд) | NПП.
    // Тот же вид ключа строит запрос ВОР_СвязьСО в шаблоне ВОР.
    // Если ни один файл не прочитан, данных нет: остаются только строки с ошибками.
    Данные = if not Table.HasColumns(СРазделом, "ИдСтроки") then #table({}, {}) else
        let
            КлючСО = Table.AddColumn(Свёрнутые, "КлючСО", each
                (if [ШифрПроекта] = null then "" else [ШифрПроекта]) & "|"
                & (if [НомИзмПроекта] = null then "" else Text.From([НомИзмПроекта])) & "|"
                & (if [ДатаИзм] = null then "" else Date.ToText([ДатаИзм], "yyyy-MM-dd")) & "|"
                & (if [NПП] = null then "" else Text.Trim(Text.From([NПП]))), type text),
            Порядок = Table.ReorderColumns(КлючСО, Начало, MissingField.Ignore)
        in
            Table.ReorderColumns(Порядок, List.RemoveItems(Table.ColumnNames(Порядок), {"КлючСО"}) & {"КлючСО"}),

    // Файлы, которые не удалось прочитать: строка с текстом ошибки
    Итог = Table.Combine({Данные} & ОшибочныеТаблицы)
in
    Итог
