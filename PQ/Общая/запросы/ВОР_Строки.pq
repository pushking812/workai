let
    // Строки ВОР для сверки с СО: нужные колонки ФайлBinary (если колонки нет, она пустая).
    // Строки файлов с ошибкой чтения (без ИдСтроки) в сверку не входят.
    Источник = ФайлBinary,
    Нужные = {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "Раздел",
              "NПП", "НаименованиеРабот", "ЕдИзм", "КолВо", "ДопКолВО", "NППРДСО"},
    Колонки = if Table.HasColumns(Источник, "ИдСтроки")
        then Table.SelectColumns(Источник, Нужные, MissingField.UseNull)
        else #table(Нужные, {}),
    Итог = Table.SelectRows(Колонки, each [ИдСтроки] <> null)
in
    Итог
