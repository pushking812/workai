let
    // Итоговая связь ВОР - СО: связь по номеру (ВОР_СвязьСО: строго и без даты) плюс однозначные пары по наименованию (СвязьПоИмени).
    // Пары по наименованию получают СвязьПоИмени = 1 и NППВОР (номер пункта в ВОР); NПП и КлючСО у них - номер и ключ пункта СО,
    // ДатаСО - дата СО. Пересечение, Связь_ВОР_СО, Только_в_ВОР и Только_в_СО читают связь отсюда.
    // На лист Ошибки пара выводится предупреждением.
    ПоНомеру = Table.AddColumn(Table.AddColumn(ВОР_СвязьСО, "СвязьПоИмени", each 0, Int64.Type), "NППВОР", each null, type nullable text),
    Пары = Table.SelectRows(СвязьПоИмени, each [Статус] = "по наименованию"),
    ПарыТ = Table.AddColumn(Table.AddColumn(Table.AddColumn(
        Table.SelectColumns(Пары, {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NППСО", "КлючСО", "ДатаСО", "NПП"}),
        "СвязьБезДаты", each 0, Int64.Type), "СвязьПоИмени", each 1, Int64.Type), "NППВОР", each [NПП], type nullable text),
    ПарыСО = Table.RenameColumns(Table.RemoveColumns(ПарыТ, {"NПП"}), {{"NППСО", "NПП"}}),
    Итог = Table.Combine({ПоНомеру, ПарыСО})
in
    Итог
