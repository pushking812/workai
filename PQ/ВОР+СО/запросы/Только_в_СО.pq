let
    // Таблица 2: строки СО с номером пункта, на который в ВОР нет ссылки (ключ
    // ШифрПроекта|НомИзмПроекта|ДатаИзм|NПП не встречается в ВОР_СвязьСО).
    Ссылки = Table.Distinct(Table.SelectColumns(ВОР_СвязьИтог, {"КлючСО"})),
    БезВложенной = Table.RemoveColumns(
        Table.NestedJoin(СО_Строки, {"КлючСО"}, Ссылки, {"КлючСО"}, "вор", JoinKind.LeftAnti), {"вор"}),
    Порядок = Table.ReorderColumns(БезВложенной,
        {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "Раздел", "Комплект",
         "NПП", "НаименованиеИТехХар", "ЕдИзм", "КолВо", "Примечание", "КлючСО"}),
    Итог = Table.TransformColumnTypes(Порядок, {{"ДатаИзм", type date}, {"КолВо", type number}})
in
    Итог
