let
    Source = СписокФайлов,
    
    // Прогоняем каждый файл через функцию, ловим ошибки
    ДобавленыДанные = Table.AddColumn(Source, "Данные", each 
        let
            результат = try fnProcessFile([ПолныйПуть])
        in
            if результат[HasError] then 
                // Если упало - создаем таблицу с ошибкой, чтобы не ломался весь пакет
                #table({"Таблица", "Предупреждение"}, {{null, "Ошибка в файле " & [ПолныйПуть] & ": " & результат[Error][Message]}})
            else 
                результат[Value]
    ),
    
    // Объединяем все таблицы в одну
    Объединено = Table.Combine(ДобавленыДанные[Данные])
in
    Объединено