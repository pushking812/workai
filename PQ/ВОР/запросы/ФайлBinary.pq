let
    База = ВОР_База,

    // Строки файлов с ошибкой чтения (колонка "Предупреждение") отделяем и возвращаем в конец
    ЕстьОшибки = Table.HasColumns(База, "Предупреждение"),
    ОшибочныеТаблицы = if ЕстьОшибки
        then {Table.SelectColumns(Table.SelectRows(База, each [Предупреждение] <> null), {"ИмяФайла", "Предупреждение"})}
        else {},
    Хорошие = if ЕстьОшибки
        then Table.RemoveColumns(Table.SelectRows(База, each [Предупреждение] = null), {"Предупреждение"})
        else База,

    ДобавленыЧертежи = Table.AddColumn(Хорошие, "РазделенныеЧертежи", each fnParseChertezhi([Чертежи])),
    РазвернутыЧертежи = Table.ExpandRecordColumn(ДобавленыЧертежи, "РазделенныеЧертежи", {"ШифрРД", "ЛистыРД"}),
    УдаленыЧертежи = Table.RemoveColumns(РазвернутыЧертежи, {"Чертежи"}),

    ДобавленыСпец = Table.AddColumn(УдаленыЧертежи, "РазделенныеСпец", each fnParseSpec([Спецификации])),
    РазвернутыСпец = Table.ExpandRecordColumn(ДобавленыСпец, "РазделенныеСпец", {"ШифрРДСО", "NППРДСО"}),
    УдаленыСпецификации0 = Table.RemoveColumns(РазвернутыСпец, {"Спецификации"}),

    // Позиции СО, указанные в наименовании работ ("см. спец. Поз. 73", "(...СО (поз. 11.4-11.6))"),
    // добавляются к NППРДСО из столбца ссылок (без повторов).
    НомераВсе = Table.AddColumn(УдаленыСпецификации0, "NППРДСО_все", each
        Text.Combine(List.Distinct(List.Select(
            Text.Split(if [NППРДСО] = null then "" else Text.From([NППРДСО]), ",")
            & Text.Split(fnSpecFromName([НаименованиеРабот]), ","), each _ <> "")), ","), type text),
    УдаленыСпецификации = Table.RenameColumns(Table.RemoveColumns(НомераВсе, {"NППРДСО"}), {{"NППРДСО_все", "NППРДСО"}}),

    // Шифр: ШифрРД, если пуст - ШифрРДСО; заполняется вниз внутри файла/таблицы,
    // начальные пустые получают первое найденное значение
    ДобавленОбъединенныйШифр = Table.AddColumn(УдаленыСпецификации, "ШифрОбъединенный", each
        let v = if [ШифрРД] = null or [ШифрРД] = "" then [ШифрРДСО] else [ШифрРД]
        in if v = null or v = "" then null else v),
    ШифрЗаполнен = Table.Combine(Table.Group(ДобавленОбъединенныйШифр, {"ИмяФайла", "Таблица"}, {{"Данные", each
        let
            вниз = Table.FillDown(_, {"ШифрОбъединенный"}),
            значения = List.RemoveNulls(Table.Column(вниз, "ШифрОбъединенный")),
            первое = if List.IsEmpty(значения) then null else значения{0}
        in
            if первое = null then вниз else Table.TransformColumns(вниз, {{"ШифрОбъединенный", each if _ = null then первое else _}}),
        type table}}, GroupKind.Local)[Данные]),

    УдаленыИсходныеШифры = Table.RemoveColumns(ШифрЗаполнен, {"ШифрРД", "ШифрРДСО"}),
    // ШифрРД дублирует ШифрПроекта: столбец с шифром не нужен, убираем
    БезШифраРД = Table.RemoveColumns(УдаленыИсходныеШифры, {"ШифрОбъединенный"}),

    ФинальныйПорядок = Table.ReorderColumns(БезШифраРД,
        {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "NПП", "NВЛСР", "НаименованиеРабот", "ЕдИзм", "КолВо", "ДопКолВО",
         "ЛистыРД", "NППРДСО", "ФормулаРасРасОбъРабИРасМат", "Раздел", "Проверка"}),

    ДобавленоПредупреждение = Table.AddColumn(ФинальныйПорядок, "Предупреждение", each
        let
            okRD = fnOnlyAllowedChars([ЛистыРД], "0123456789,."),
            okRDSO = fnOnlyAllowedChars([NППРДСО], "0123456789,."),
            msgs = List.RemoveNulls({
                if okRD then null else "ЛистыРД: " & Text.From([ЛистыРД]),
                if okRDSO then null else "NППРДСО: " & Text.From([NППРДСО])
            })
        in
            if List.IsEmpty(msgs) then null else Text.Combine(msgs, " | ")),

    // Файлы, которые не удалось прочитать: строка с текстом ошибки
    Склеено = Table.Combine({ДобавленоПредупреждение} & ОшибочныеТаблицы),
    // Столбец "Предупреждение" остаётся, только если в нём есть значения (иначе последний столбец пустой)
    Данные = if List.IsEmpty(List.RemoveNulls(Table.Column(Склеено, "Предупреждение")))
        then Table.RemoveColumns(Склеено, {"Предупреждение"})
        else Склеено,

    // Если файлов нет, возвращается пустая таблица с полной схемой (типы заданы): обновление проходит,
    // общая книга и сводные видят все поля, включая КолВо (число).
    Схема = {"ИдСтроки", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "ИмяФайла", "Таблица", "Строка", "NПП", "NВЛСР",
             "НаименованиеРабот", "ЕдИзм", "КолВо", "ДопКолВО", "ЛистыРД", "NППРДСО", "ФормулаРасРасОбъРабИРасМат", "Раздел", "Проверка"},
    ПустаяТаблица = Table.TransformColumnTypes(#table(Схема, {}),
        List.Transform(Схема, each {_, if _ = "КолВо" then type number else if _ = "ДатаИзм" then type nullable date
            else if _ = "Таблица" or _ = "Строка" then Int64.Type else type text})),
    Объединено = if Table.HasColumns(Хорошие, "КолВо") then Данные else Table.Combine({ПустаяТаблица} & ОшибочныеТаблицы),
    // Table.Combine теряет тип колонки: задаём явно, иначе Excel не применит формат даты
    Итог = Table.TransformColumnTypes(Объединено, {{"ДатаИзм", type nullable date}})
in
    Итог
