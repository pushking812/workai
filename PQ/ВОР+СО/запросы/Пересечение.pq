let
    // Таблица 1: пункты СО, на которые есть ссылка в ВОР и которые есть в СО (по ключу
    // ШифрПроекта|НомИзмПроекта|ДатаИзм|NПП). Одна строка на пункт: сколько строк ВОР на него ссылается
    // и сколько строк СО под этим номером. Объёмы не сравниваются.
    // Столбец Связь: «по номеру» - ключ совпал целиком; «без даты» - совпал без даты изменения (см. Ошибки);
    // «по наименованию, ВОР <номер>» - номера разные, пункты совпали по словам наименования (предупреждение на листе Ошибки).
    Ссылки = Table.Group(ВОР_СвязьИтог, {"КлючСО", "ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NПП"},
        {{"СтрокВОР", each List.Count(List.Distinct([ИдСтроки])), Int64.Type},
         {"Связь", each
            if List.Max([СвязьПоИмени]) = 1 then "по наименованию, ВОР " & Text.Combine(List.Distinct(List.RemoveNulls([NППВОР])), ", ")
            else if List.Max([СвязьБезДаты]) = 1 then "без даты"
            else "по номеру", type text}}),
    ПоКлючу = Table.Group(СО_Строки, {"КлючСО"},
        {{"СтрокСО", each Table.RowCount(_), Int64.Type},
         {"СО_Наименование", each List.First(List.RemoveNulls([НаименованиеИТехХар])), type nullable text}}),
    Соединено = Table.ExpandTableColumn(
        Table.NestedJoin(Ссылки, {"КлючСО"}, ПоКлючу, {"КлючСО"}, "со", JoinKind.Inner),
        "со", {"СтрокСО", "СО_Наименование"}),
    Переименовано = Table.RenameColumns(Соединено, {{"NПП", "NППСО"}}),
    Порядок = Table.ReorderColumns(Переименовано,
        {"ШифрПроекта", "НомИзмПроекта", "ДатаИзм", "NППСО", "СО_Наименование", "СтрокВОР", "СтрокСО", "Связь", "КлючСО"}),
    Итог = Table.TransformColumnTypes(Порядок, {{"ДатаИзм", type date}, {"СтрокСО", Int64.Type}})
in
    Итог
