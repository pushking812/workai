(tbl as table, справочник as table, optional ignoreColumns as list) as table =>
let
    _ignore = if ignoreColumns = null then {} else ignoreColumns,
    
    // Нормализация: переносы/табы → пробел, сжатие пробелов, трим
    norm = (txt as any) as text =>
        let
            s = if txt = null then "" else Text.From(txt),
            step1 = Text.Replace(Text.Replace(Text.Replace(s, "#(lf)", " "), "#(cr)", " "), "#(tab)", " "),
            step2 = Text.Trim(step1)
        in
            step2,
    
    фактические = List.Difference(Table.ColumnNames(tbl), _ignore),
    роли = List.Distinct(Table.Column(справочник, "Роль")),
    
    // 1. Проверка количества
    проверкаКоличества = 
        if List.Count(роли) <> List.Count(фактические) then
            error "Несовпадение количества столбцов. " &
                "В справочнике ролей: " & Text.From(List.Count(роли)) & 
                ", в таблице ВОР: " & Text.From(List.Count(фактические)) & 
                " (" & Text.Combine(фактические, ", ") & "). " &
                "Проверьте справочник заголовков."
        else true,
    
    // 2. Поиск: сравниваем НОРМАЛИЗОВАННЫЕ строки
    маппинг = List.Transform(роли, (роль) =>
        let
            варианты = Table.Column(
                Table.SelectRows(справочник, each [Роль] = роль), "Вариант"),
            вариантыНорм = List.Distinct(
                List.Select(List.Transform(варианты, each norm(_)), each _ <> "")
            ),
            найденный = List.First(
                List.Select(фактические, (факт) => 
                    List.Contains(вариантыНорм, norm(факт))
                ),
                null
            )
        in
            if найденный = null then
                error "Не найдена колонка для роли """ & роль & """. " &
                    "Варианты в справочнике: [" & Text.Combine(варианты, ", ") & "]. " &
                    "Фактические колонки: [" & Text.Combine(фактические, ", ") & "]. " &
                    "Добавьте нужное значение в справочник заголовков."
            else
                {найденный, роль}
    ),
    
    // 3. Проверка на дубли
    использованные = List.Transform(маппинг, each _{0}),
    проверкаДублей = 
        if List.Count(использованные) <> List.Count(List.Distinct(использованные)) then
            error "Один и тот же фактический столбец сопоставлен нескольким ролям. " &
                "Проверьте справочник заголовков на пересекающиеся варианты."
        else true
in
    if проверкаКоличества and проверкаДублей 
    then Table.RenameColumns(tbl, маппинг)
    else error "Недостижимая ветка"